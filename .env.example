# ==========================================================================
# Variables de entorno de la app (Next.js) — PHSPORT Dashboard
# --------------------------------------------------------------------------
# Copia este fichero a `.env.local` y rellena los valores para desarrollo.
# NUNCA subas `.env.local` a Git (está en .gitignore).
# En producción/preview, estas variables se configuran en Vercel:
#   Settings → Environment Variables.
# ==========================================================================

# --- Supabase (cliente) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Agente de parseo (servidor) — Claude Haiku ---
# Opcional: si falta, el taller de creación sigue funcionando sin el agente
# (degrada limpio a introducción manual).
ANTHROPIC_API_KEY=

# --- Notificaciones push (cliente) — clave PÚBLICA VAPID ---
# Genera el par de claves con:  npx web-push generate-vapid-keys
# Aquí va SOLO la pública. La privada va en los secretos de Supabase (abajo).
NEXT_PUBLIC_VAPID_KEY=

# --------------------------------------------------------------------------
# Estas cuatro son TODAS las que lee la app. Si en algún documento antiguo
# aparece `NEXT_PUBLIC_APP_URL`, ignóralo: no la lee nadie (comprobado
# 2026-09-07). No la añadas «por si acaso».
# --------------------------------------------------------------------------

# ==========================================================================
# Secretos de las Edge Functions de Supabase — NO van aquí ni en Vercel.
# Se configuran en: Supabase → Edge Functions → Secrets
#
#   send-notification-email:
#     RESEND_API_KEY
#     RESEND_FROM_EMAIL           (ej. noreply@phsport.app)
#
#   send-push-notification:
#     VAPID_PUBLIC_KEY            (la misma pública de arriba)
#     VAPID_PRIVATE_KEY           (la privada — secreta)
#     VAPID_SUBJECT               (ej. mailto:mariorodpz@gmail.com)
#
#   SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase solo.
# ==========================================================================
